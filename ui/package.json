{
  "name": "watchdog-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "watchdog host control UI components and demo shell",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test": "playwright test",
    "test:host": "playwright test --config playwright.host.config.ts",
    "verify": "npm run typecheck && npm run build && npm run check:bundle && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
